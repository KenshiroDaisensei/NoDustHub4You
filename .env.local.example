# Google Sheets API Configuration
# ถ้าต้องการใช้ Google Sheets เป็น data source:
# 1. สร้าง Google Service Account ที่ Google Cloud Console
# 2. เปิด Google Sheets API + Google Drive API
# 3. ใส่ค่าด้านล่างแทน 11111
# 4. Share Google Sheets ให้ service account email มีสิทธิ์อ่าน
# 5. เปลี่ยน SPREADSHEET_ID ในไฟล์ src/app/api/drive/route.ts
# 6. Copy ไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
GOOGLE_SERVICE_ACCOUNT_EMAIL=11111
GOOGLE_PRIVATE_KEY=11111
GOOGLE_DRIVE_FILE_ID=11111
